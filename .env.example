# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# Database (SQLite or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./database.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nexora

# Redis (optional - leave empty for stateless mode)
REDIS_URL=

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
ENVIRONMENT=production
DEBUG=false

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Residential proxy (optional)
RESIDENTIAL_PROXY_URL=

# Auto-render fallback
AUTO_RENDER_ENABLED=true

# Playwright
PLAYWRIGHT_BROWSERS_PATH=